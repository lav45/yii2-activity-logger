#!/usr/bin/env bash

DOCKER_ARG='-i'
if [ -t 0 ] && [ -t 1 ]; then
  DOCKER_ARG='-it'
fi

if docker info --format '{{.SecurityOptions}}' | grep -q rootless; then
  user_args=(-u "0:0")
else
  user_args=(-u "$(id -u):$(id -g)")
fi

docker run --rm $DOCKER_ARG \
  "${user_args[@]}" \
  -v $(pwd):/app \
  -w /app \
  -e COMPOSER_HOME=/app/.composer \
  yii2-activity-logger-dev:latest /usr/local/bin/composer $@
