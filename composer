#!/usr/bin/env bash

DOCKER_ARG='-i'
if [ -t 0 ] && [ -t 1 ]; then
  DOCKER_ARG='-it'
fi

if docker info --format '{{.SecurityOptions}}' | grep -q rootless; then
  user_args=(-u "0:0")
else
  user_args=(-u "$(id -u):$(id -g)")
fi

IMAGE=yii2-activity-logger-dev:latest

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Docker image $IMAGE not found. Build it first: ./build.sh" >&2
  exit 1
fi

docker run --rm $DOCKER_ARG \
  "${user_args[@]}" \
  -v $(pwd):/app \
  -w /app \
  -e COMPOSER_HOME=/app/.composer \
  "$IMAGE" /usr/local/bin/composer $@
